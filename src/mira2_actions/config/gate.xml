<root BTCPP_format="4" main_tree_to_execute="Gate">
  <BehaviorTree ID="Gate">
    <Sequence>
      <ScanArea radius="{scan_radius}" sweep_degrees="{scan_sweep}" step_degrees="{scan_step}" depth="{scan_depth}" face_class="{target_class}" timeout="150"/>
      <SelectObject class_id="{target_class}" object="{target}"/>
      <TraverseGate object="{target}" class_id="{target_class}" through_distance="1.5" timeout="90"/>
    </Sequence>
  </BehaviorTree>
</root>
